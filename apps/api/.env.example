NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/kontora
# мінімум 32 символи: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=12h
# кілька origin через кому
CORS_ORIGIN=http://localhost:5173
# часовий пояс установи: від нього залежать «сьогодні», фільтри за датами і статистика
APP_TIMEZONE=Europe/Kyiv

# для npm run seed
SEED_ADMIN_EMAIL=admin@kontora.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Адміністратор
